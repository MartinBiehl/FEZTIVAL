# Copie para .env.local e preencha. Nada aqui vai para o navegador.

# Postgres. Em desenvolvimento (Homebrew):
#   brew install postgresql@17 && brew services start postgresql@17
#   createdb feztival
DATABASE_URL=postgres://localhost:5432/feztival

# Pasta das fotos enviadas pelos artistas. Precisa de disco persistente.
MEDIA_DIR=storage/media

# SMTP dos e-mails de conta (confirmacao e codigo de recuperacao), por
# exemplo smtps://usuario:senha@smtp.exemplo.com:465. Vazio em
# desenvolvimento: os e-mails sao impressos no terminal do `npm run dev`.
SMTP_URL=
MAIL_FROM="Feztival <nao-responda@feztival.local>"
